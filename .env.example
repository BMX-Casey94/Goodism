# Copy to .env and fill in. Never commit .env.
#
# Only needed for LLM-backed steps: OCR of scanned images/PDFs, the
# proofreader, structurer and conflict subagents. Native DOCX/PDF/TXT
# conversion, validation, indexing, search and the MCP server work without it.
# Verify your setup with:  kb check-llm

# --- Provider (pick ONE block, uncomment it, and set the key) --------------

# OpenAI
# KB_LLM_BASE_URL=https://api.openai.com/v1
# KB_MODEL_BULK=<cheaper vision-capable model>
# KB_MODEL_STRONG=<stronger vision-capable model>

# xAI (Grok)
# KB_LLM_BASE_URL=https://api.x.ai/v1
# KB_MODEL_BULK=<grok vision-capable model>
# KB_MODEL_STRONG=<grok vision-capable model>

# OpenRouter (supports Gemini Flash, DeepSeek 4.1, Claude, GPT, etc.)
# KB_LLM_BASE_URL=https://openrouter.ai/api/v1
# KB_LLM_API_KEY=sk-or-v1-...
# KB_MODEL_BULK=google/gemini-2.5-flash
# KB_MODEL_STRONG=google/gemini-2.5-flash

# Local (Ollama / LM Studio, OpenAI-compatible endpoint). Keeps content off
# third-party APIs. The model must support image input for OCR.
# KB_LLM_BASE_URL=http://localhost:11434/v1
# KB_LLM_API_KEY=local
# KB_MODEL_BULK=<local vision model>
# KB_MODEL_STRONG=<local vision model>

KB_LLM_BASE_URL=
KB_LLM_API_KEY=

# Model routing. BULK = extractor/proofreader/structurer (cheap, high volume).
# STRONG = verifier/conflict/hard OCR (the second OCR pass uses STRONG, so
# the two passes use different models where possible, reducing shared errors).
KB_MODEL_BULK=
KB_MODEL_STRONG=

# --- Embeddings -------------------------------------------------------------
# Local (default; no API, content stays on this machine):
KB_EMBEDDING_MODEL=local:BAAI/bge-small-en-v1.5
# API alternative (requires the provider block above or these overrides):
#   KB_EMBEDDING_MODEL=text-embedding-3-small
#   KB_EMBEDDING_BASE_URL=
#   KB_EMBEDDING_API_KEY=

# --- MCP server -------------------------------------------------------------
# Required only when KB_MCP_TRANSPORT=sse (hosted). stdio needs no token.
KB_MCP_TRANSPORT=stdio
KB_MCP_AUTH_TOKEN=
KB_MCP_MAX_CONCURRENCY=4

# --- Client review WebApp / retrieval API -----------------------------------
# Mandatory (>=32 chars) if KB_WEB_HOST is not a loopback address.
KB_WEB_HOST=127.0.0.1
KB_WEB_PORT=8080
KB_WEB_AUTH_TOKEN=
KB_WEB_SECURE_COOKIE=0
KB_WEB_MAX_CONCURRENCY=4
