# Copy to .env.local for local dev, or set these in Vercel -> Project Settings -> Environment Variables.
# Never commit .env.local.

# --- Python retrieval backend (server/web_app.py) ---------------------------
# Local dev: http://127.0.0.1:8080
# Vercel production: your Cloudflare Tunnel / Railway / Fly / VPS URL (no trailing slash)
KB_BACKEND_URL=http://127.0.0.1:8080

# Must match KB_WEB_AUTH_TOKEN on the Python backend (required when backend is off loopback).
KB_BACKEND_TOKEN=

# --- OpenRouter LLM (server-side only; never exposed to browser) ------------
OPENROUTER_API_KEY=
# Examples: google/gemini-3.1-flash-lite-preview, deepseek/deepseek-chat
OPENROUTER_MODEL=google/gemini-3.1-flash-lite-preview
OPENROUTER_SITE_URL=https://goodism.vercel.app
OPENROUTER_SITE_NAME=Goodism Knowledge Base

# --- Optional Client Access Gate (recommended on public Vercel URLs) --------
# Set a passcode to prevent unauthorised visitors from using your OpenRouter credits.
APP_ACCESS_PASSCODE=
# Random 32+ character string used to sign the HttpOnly session cookie.
APP_SESSION_SECRET=
