{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goodism.local/schema/document.schema.json",
  "title": "Goodism corpus document front matter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "title", "domain", "topics", "doc_type",
    "source_file", "source_sha256",
    "authority", "precedence", "status",
    "extraction_method", "summary"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable, never-reused kebab-case identifier."
    },
    "title": { "type": "string", "minLength": 1 },
    "domain": {
      "type": "string",
      "description": "Top-level grouping. Must exist in schema/vocab/domains.yaml."
    },
    "topics": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Must exist in schema/vocab/topics.yaml."
    },
    "doc_type": {
      "type": "string",
      "description": "Must exist in schema/vocab/doc-types.yaml."
    },
    "source_file": {
      "type": "string",
      "description": "Path to the original, relative to raw/."
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the original file in raw/."
    },
    "authority": {
      "type": "string",
      "enum": ["canonical", "supporting", "contextual", "superseded"]
    },
    "precedence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "description": "Lower number prevails when documents conflict."
    },
    "status": {
      "type": "string",
      "enum": ["draft", "reviewed", "published", "superseded"]
    },
    "effective_date": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "supersedes": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "superseded_by": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "conflicts_with": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Human-approved ids of documents with known contradictions."
    },
    "extraction_method": {
      "type": "string",
      "enum": ["native-text", "ocr", "vision", "manual"]
    },
    "ocr_confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1,
      "description": "Required when extraction_method is ocr or vision."
    },
    "needs_review": {
      "type": "boolean",
      "default": false
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "Index-time only. Never quoted back as source text."
    },
    "key_terms": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Synonyms and alternate phrasings used for query expansion."
    },
    "chunk_max_tokens": {
      "type": "integer",
      "minimum": 40,
      "maximum": 800,
      "description": "Optional per-document override of the maximum chunk size. Use a small value for glossaries and dictionaries so each entry is its own retrievable chunk."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "extraction_method": { "enum": ["ocr", "vision"] } }
      },
      "then": {
        "required": ["ocr_confidence"]
      }
    }
  ]
}
