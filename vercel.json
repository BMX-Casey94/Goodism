{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "kb",
          "format": "url",
          "env": "KB_BACKEND_URL"
        }
      ]
    },
    "kb": {
      "root": ".",
      "runtime": "python",
      "entrypoint": "server/web_app.py",
      "buildCommand": "KB_EMBEDDING_MODEL=fts-only KB_INDEX_PATH=server/data/kb.sqlite python -m tools.kb.cli build-index",
      "functions": {
        "server/web_app.py": {
          "includeFiles": "{server/data/**,corpus/**,schema/**,manifest/**,server/bot_system_prompt.md}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
